# ─── 数据库 ───
# SQLite 本地文件（单机部署）。生产建议挂载持久卷，如 file:/app/data/prod.db
# 若需高并发/多实例，可切换为 Turso 托管 libSQL：libsql://<your-db>.turso.io
# 或 PostgreSQL：postgresql://user:pass@host:5432/lab_safety（需同步改 prisma/schema.prisma 的 provider）
DATABASE_URL=file:/app/data/prod.db

# ─── 认证密钥（生产必填，缺失则启动失败）───
# 用 `npx tsx scripts/gen-secrets.ts` 生成强随机值，切勿使用默认值
# 仅用于历史一次性邮箱令牌兼容；登录会话已经改为数据库随机令牌
JWT_SECRET=
# 图形验证码独立签名密钥；生产推荐配置，留空时回退 JWT_SECRET
CAPTCHA_SECRET=
# API Key 加密密钥（AES-256-GCM，须 32 字节，gen-secrets 输出的 base64 即可）
CREDENTIAL_ENCRYPTION_KEY=

# ─── LLM / VLM（可选，平台默认不带 Key；用户在各实验室「API 配置」页填入）───
# 留空时将完全依赖用户自配；配置后作为未自配实验室的兜底
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-flash

# ─── 应用 ───
NODE_ENV=production
# Docker Nginx 的 server_name 与证书目录名；正式环境推荐使用域名
DOMAIN=your-domain.com
# 站点根地址（用于 Cookie 域、邮件链接等），末尾不带斜杠
APP_BASE_URL=https://your-domain.com

# ─── 生产初始化（仅 seed:prod 首次运行时使用）───
PLATFORM_ADMIN_NAME=平台管理员
PLATFORM_ADMIN_EMAIL=platform-admin@your-domain.com
PLATFORM_ADMIN_PASSWORD=请使用至少16位随机强密码

# ─── SMTP 邮件（批次 B：邮箱验证/密码重置时需要，留空则禁用邮件功能）───
# 企业微信邮箱（腾讯企业邮 exmail）示例：发件人 your-sender@your-domain.com
#   SMTP_HOST=smtp.exmail.qq.com
#   SMTP_PORT=465            （465=SSL，推荐；或 587=STARTTLS）
#   SMTP_USER=your-sender@your-domain.com   （完整邮箱地址）
#   SMTP_PASS=客户端专用密码           （见下）
#   SMTP_FROM="实验室安全平台 <your-sender@your-domain.com>"
# 关于 SMTP_FROM：仅其中的「显示名」生效，发件地址会被强制设为 SMTP_USER
#   （腾讯企业邮等要求 From 地址 = 认证账号，否则报 501 mail from address must be same as authorization user）。
# 关于 SMTP_PASS：企业微信邮箱若开启了安全登录，邮箱登录密码不能直接用于 SMTP，
#   需在「企业微信邮箱 → 设置 → 客户端专用密码」生成一个专用密码填入此处。
#   该密码仅用于程序发信，不要与邮箱登录密码混用。请勿将密码提交到代码仓库。
# 未配置 SMTP_HOST 时，验证码/验证链接会降级打印到服务器控制台（仅开发用）。
# SMTP_HOST=smtp.exmail.qq.com
# SMTP_PORT=465
# SMTP_USER=your-sender@your-domain.com
# SMTP_PASS=（填客户端专用密码，勿提交真实密码到仓库）
# SMTP_FROM="实验室安全平台 <noreply@your-domain.com>"
